{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/contracts/render_props",
  "title": "XiaojinEditorial — Render Props",
  "description": "Props produced by P2 and passed to `npx remotion render XiaojinEditorial --props=<json>`. Mirrors XiaojinEditorialProps, adding durationSeconds (drives calculateMetadata) and dataCards (P3 must add an InfoCard-equivalent to the xiaojin component set). Units: scenes/chapters/introOutFrame in frames; captions in milliseconds. A plain-but-correct result must render from the required fields alone.",
  "type": "object",
  "required": [
    "videoSrc",
    "durationSeconds",
    "colorMode",
    "speakerObjectPosition",
    "scenes",
    "introOutFrame",
    "chapters",
    "captions"
  ],
  "additionalProperties": false,
  "properties": {
    "videoSrc": {
      "type": "string",
      "description": "Path relative to remotion-composer/public/, e.g. jobs/<slug>/source.mp4"
    },
    "presenter": {
      "type": "object",
      "description": "[presenter mode] speaker inset shown in the lower zone during b-roll windows; the card shows b-roll full-bleed. Written by the pipeline when insert_broll + apply_style co-occur.",
      "required": ["src", "windows"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string" },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fromFrame", "toFrame"],
            "additionalProperties": false,
            "properties": {
              "fromFrame": { "type": "integer", "minimum": 0 },
              "toFrame": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "radius": { "type": "number" },
        "objectPosition": { "type": "string" }
      }
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Output length; P3 uses it in calculateMetadata: durationInFrames = ceil(durationSeconds*30)"
    },
    "colorMode": {
      "type": "string",
      "enum": [
        "warm",
        "dark"
      ]
    },
    "speakerObjectPosition": {
      "type": "string",
      "description": "CSS object-position, e.g. \"50% 35%\"; calibrated on the SOURCE video's face, not the example video",
      "pattern": "^.+$"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "frame",
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false,
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        }
      },
      "description": "Floating-card position schedule over time (frames). Minimum: one entry at frame 0."
    },
    "opacityKeyframes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "frame",
          "opacity"
        ],
        "properties": {
          "frame": {
            "type": "integer"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "introOutFrame": {
      "type": "integer",
      "minimum": 0,
      "description": "Frame at which the intro title card exits; chrome/captions hidden before it"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "atFrame",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "atFrame": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "maxLength": 20,
            "description": "Primary label (main chapter-bar text)"
          },
          "labelEn": {
            "type": "string",
            "maxLength": 24,
            "description": "Optional secondary label (bilingual nav)"
          }
        }
      },
      "description": "Chapter markers. Produced by content_planner (single label); P3's ChapterNav uses label (+ optional labelEn)."
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "startMs",
          "endMs"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "description": "Per-phrase captions (milliseconds). Karaoke sweep is interpolated inside the component."
    },
    "dataCards": {
      "type": "array",
      "description": "[P3 NEW capability] count-up data cards. Mapped from content_planner's info_cards.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "mountFrame",
          "rows"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "x": {
            "type": "number",
            "default": 80
          },
          "y": {
            "type": "number",
            "default": 900
          },
          "width": {
            "type": "number",
            "default": 920
          },
          "mountFrame": {
            "type": "integer",
            "minimum": 0
          },
          "endFrame": {
            "type": "integer",
            "minimum": 0,
            "description": "Frame this card starts a 15-frame fade-out. Omit only if no later card ever occupies the same x/y — otherwise the two permanently overlap (confirmed bug: InfoCard had no exit logic at all)."
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 24
                },
                "value": {
                  "type": "number"
                },
                "tone": {
                  "type": "string",
                  "enum": [
                    "accent",
                    "good",
                    "bad",
                    "normal"
                  ],
                  "default": "normal"
                },
                "mountOffset": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Entrance offset (frames) relative to the card's mountFrame"
                },
                "prefix": {
                  "type": "string"
                },
                "divideBy": {
                  "type": "number"
                },
                "decimals": {
                  "type": "integer",
                  "minimum": 0
                },
                "unit": {
                  "type": "string"
                },
                "labelEn": {
                  "type": "string",
                  "maxLength": 28,
                  "description": "Optional secondary bilingual line under label (native big, EN small — reference-build style)"
                }
              }
            }
          },
          "warn": {
            "type": "boolean",
            "description": "Warning card — red accents (reference's lapse-warning styling)"
          }
        }
      }
    },
    "beforeAfter": {
      "type": "array",
      "description": "Dramatic two-value before/after reveals (e.g. a cost/metric that jumped over time) — 'before_after' rows of compose-director.md's Data Display Analysis table.",
      "items": {
        "type": "object",
        "required": [
          "kicker",
          "leftLabel",
          "leftValue",
          "rightLabel",
          "rightValue",
          "mountFrame",
          "secondRevealFrame"
        ],
        "additionalProperties": false,
        "properties": {
          "kicker": {
            "type": "string",
            "maxLength": 40
          },
          "leftLabel": {
            "type": "string",
            "maxLength": 24
          },
          "leftValue": {
            "type": "number"
          },
          "leftPrefix": {
            "type": "string"
          },
          "leftSuffix": {
            "type": "string"
          },
          "leftDecimals": {
            "type": "integer",
            "minimum": 0
          },
          "rightLabel": {
            "type": "string",
            "maxLength": 24
          },
          "rightValue": {
            "type": "number"
          },
          "rightPrefix": {
            "type": "string"
          },
          "rightSuffix": {
            "type": "string"
          },
          "rightDecimals": {
            "type": "integer",
            "minimum": 0
          },
          "mountFrame": {
            "type": "integer",
            "minimum": 0
          },
          "secondRevealFrame": {
            "type": "integer",
            "minimum": 0
          },
          "endFrame": {
            "type": "integer",
            "minimum": 0,
            "description": "Frame this card starts a 15-frame fade-out. Omit only if no later card ever occupies the same x/y."
          },
          "x": {
            "type": "number",
            "default": 80
          },
          "y": {
            "type": "number",
            "default": 900
          },
          "width": {
            "type": "number",
            "default": 920
          }
        }
      }
    },
    "gauges": {
      "type": "array",
      "description": "Semicircle risk/status gauges — 'risk consequence' rows of compose-director.md's Data Display Analysis table.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "leftLabel",
          "rightLabel",
          "value",
          "mountFrame"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "leftLabel": {
            "type": "string"
          },
          "rightLabel": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Final fill fraction, 0-1"
          },
          "mountFrame": {
            "type": "integer",
            "minimum": 0
          },
          "fillDelayFrames": {
            "type": "integer",
            "minimum": 0,
            "default": 20
          },
          "fillDurationFrames": {
            "type": "integer",
            "minimum": 0,
            "default": 50
          },
          "endFrame": {
            "type": "integer",
            "minimum": 0,
            "description": "Frame this card starts a 15-frame fade-out. Omit only if no later card/gauge ever occupies the same x/y."
          },
          "x": {
            "type": "number",
            "default": 80
          },
          "y": {
            "type": "number",
            "default": 900
          }
        }
      }
    },
    "countdowns": {
      "type": "array",
      "description": "Circular countdown rings — 'countdown days' rows of compose-director.md's Data Display Analysis table.",
      "items": {
        "type": "object",
        "required": [
          "value",
          "unitLabel",
          "label",
          "headline",
          "mountFrame"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number"
          },
          "unitLabel": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "headlineAccent": {
            "type": "string"
          },
          "maxValue": {
            "type": "number",
            "description": "If given, ring fill = value/maxValue; omit for a full reveal regardless of value"
          },
          "mountFrame": {
            "type": "integer",
            "minimum": 0
          },
          "revealFrames": {
            "type": "integer",
            "minimum": 0,
            "default": 40
          },
          "endFrame": {
            "type": "integer",
            "minimum": 0,
            "description": "Frame this card starts a 15-frame fade-out. Omit only if no later card/ring ever occupies the same x/y."
          },
          "x": {
            "type": "number",
            "default": 80
          },
          "y": {
            "type": "number",
            "default": 900
          }
        }
      }
    },
    "calendarEvents": {
      "type": "array",
      "description": "Mini-calendars with a pulsing target-date marker — 'specific date' rows of compose-director.md's Data Display Analysis table. Grid is computed from real year/month, not hardcoded.",
      "items": {
        "type": "object",
        "required": [
          "year",
          "month",
          "targetDay",
          "eventLabel",
          "mountFrame"
        ],
        "additionalProperties": false,
        "properties": {
          "year": {
            "type": "integer"
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "targetDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "todayDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "eventLabel": {
            "type": "string"
          },
          "mountFrame": {
            "type": "integer",
            "minimum": 0
          },
          "endFrame": {
            "type": "integer",
            "minimum": 0,
            "description": "Frame this card starts a 15-frame fade-out. Omit only if no later card/calendar ever occupies the same x/y."
          },
          "x": {
            "type": "number",
            "default": 80
          },
          "y": {
            "type": "number",
            "default": 900
          }
        }
      }
    },
    "qrContact": {
      "type": "object",
      "description": "QR code + WhatsApp CTA close. Only include when a real contact URL was actually supplied — never fabricate one; qrSrc must point at a real generated QR image.",
      "required": [
        "qrSrc",
        "contactName",
        "ctaLabel",
        "mountFrame"
      ],
      "additionalProperties": false,
      "properties": {
        "qrSrc": {
          "type": "string",
          "description": "Path relative to remotion-composer/public/, e.g. jobs/<slug>/qr.png"
        },
        "contactName": {
          "type": "string"
        },
        "contactCompany": {
          "type": "string"
        },
        "ctaLabel": {
          "type": "string"
        },
        "mountFrame": {
          "type": "integer",
          "minimum": 0
        },
        "x": {
          "type": "number",
          "default": 80
        },
        "y": {
          "type": "number",
          "default": 780
        }
      }
    },
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        }
      }
    },
    "outro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromFrame"
      ],
      "properties": {
        "kicker": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "headlineAccent": {
          "type": "string"
        },
        "subtext": {
          "type": "string"
        },
        "ctaLabel": {
          "type": "string"
        },
        "footerLabel": {
          "type": "string"
        },
        "fromFrame": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentNameZh": {
          "type": "string"
        },
        "agentNameEn": {
          "type": "string"
        },
        "titleZh": {
          "type": "string"
        },
        "licenseNo": {
          "type": "string"
        },
        "insurer": {
          "type": "string"
        }
      },
      "$comment": "compliance and brand are mutually exclusive"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "headingFont": {
      "type": "string",
      "default": "Inter"
    },
    "labelFont": {
      "type": "string",
      "default": "Inter"
    },
    "sections": {
      "type": "array",
      "description": "[PROPOSED extension — P2 prototype, pending three-way sync] Full-canvas chapter takeovers: background override + eyebrow/title header + section icon. Generalized from video-studio's hand-built section components.",
      "items": {
        "type": "object",
        "required": [
          "fromFrame",
          "toFrame"
        ],
        "additionalProperties": false,
        "properties": {
          "fromFrame": {
            "type": "integer",
            "minimum": 0
          },
          "toFrame": {
            "type": "integer",
            "minimum": 0
          },
          "eyebrow": {
            "type": "string",
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "maxLength": 24
          },
          "icon": {
            "type": "string",
            "enum": [
              "shield_check",
              "warning",
              "clock"
            ]
          },
          "colorMode": {
            "type": "string",
            "enum": [
              "warm",
              "dark"
            ]
          },
          "warn": {
            "type": "boolean"
          },
          "timeline": {
            "type": "object",
            "description": "Full-canvas multi-stage process timeline filling this section's takeover (see TimelineSection). Only renders when this section's resolved colorMode is 'dark' — omit `icon` on sections that carry this, they occupy the same vertical space.",
            "required": [
              "heading",
              "nodes"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "maxLength": 40
              },
              "nodes": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "revealFrame",
                    "prefix",
                    "target",
                    "unit"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 24
                    },
                    "revealFrame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "prefix": {
                      "type": "string"
                    },
                    "target": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "isTotal": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "quotes": {
      "type": "array",
      "description": "[PROPOSED extension — P2 prototype] Pull-quote typography moments: verbatim spoken lines promoted to canvas graphics (the data-less video's equivalent of dataCards).",
      "items": {
        "type": "object",
        "required": [
          "text",
          "mountFrame"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 80
          },
          "attribution": {
            "type": "string",
            "maxLength": 40
          },
          "mountFrame": {
            "type": "integer",
            "minimum": 0
          },
          "endFrame": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number"
          }
        }
      }
    },
    "atmosphereKeywords": {
      "type": "array",
      "maxItems": 10,
      "description": "[PROPOSED extension — P2 prototype] Faint drifting background keyword texture — words from THIS video's own vocabulary (planner-extracted).",
      "items": {
        "type": "string",
        "maxLength": 16
      }
    }
  }
}