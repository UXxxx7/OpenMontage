# ── WhatsApp Cloud API ─────────────────────────────────────────────
WA_TOKEN=your_whatsapp_access_token
WA_PHONE_ID=your_phone_number_id
WA_APP_SECRET=your_app_secret
WA_VERIFY_TOKEN=your_custom_verify_token

# ── LLM (script generation) ────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# ── Infrastructure ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
OUTPUT_ROOT=/tmp/wa-montage-projects
PORT=3000

# ── Pipeline: HeyGen avatar ────────────────────────────────────────
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_AVATAR_ID=Daisy-inskirt-20220818
HEYGEN_VOICE_ID=2d5b0e6cf36f460aa7fc47e3eee4ba54
HEYGEN_RESOLUTION=720p

# ── Pipeline: Whisper transcription ────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# ── Pipeline: Remotion render ──────────────────────────────────────
REMOTION_DIR=/path/to/your/remotion/project
VIDEO_FPS=25

# ── OpenMontage tools (optional) ───────────────────────────────────
OPEN_MONTAGE_PATH=/path/to/OpenMontage
